import { build } from 'esbuild';
import { mkdir, rm, copyFile, writeFile } from 'node:fs/promises';
import { existsSync, readFileSync, readdirSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import path from 'node:path';

const root = fileURLToPath(new URL('../', import.meta.url));
const outdir = path.join(root, 'src/renderer/vendor/diffs');
await rm(outdir, { recursive: true, force: true });
await mkdir(outdir, { recursive: true });
const result = await build({
  absWorkingDir: root,
  entryPoints: { diffs: 'scripts/diffs-entry.mts' },
  outdir, bundle: true, splitting: true, format: 'esm', platform: 'browser',
  target: 'chrome152', minify: true, legalComments: 'linked', metafile: true,
  chunkNames: 'chunks/[name]-[hash]',
});
await copyFile(path.join(root, 'node_modules/@pierre/diffs/LICENSE.md'), path.join(outdir, 'LICENSE.txt'));
const packages = new Map<string, string>();
for (const input of Object.keys(result.metafile.inputs).filter(input => input.includes('node_modules/'))) {
  let dir = path.dirname(path.join(root, input));
  while (dir !== root && !existsSync(path.join(dir, 'package.json'))) dir = path.dirname(dir);
  if (dir === root || packages.has(dir)) continue;
  const pkg: { name: string; version: string; license?: string } = JSON.parse(readFileSync(path.join(dir, 'package.json'), 'utf8'));
  const licenses = readdirSync(dir).filter(file => /^(licen[cs]e|notice)(\.|$)/i.test(file));
  packages.set(dir, `${pkg.name}@${pkg.version} (${pkg.license || 'see notice'})\n${licenses.map(file => readFileSync(path.join(dir, file), 'utf8')).join('\n')}`);
}
await writeFile(path.join(outdir, 'THIRD_PARTY_LICENSES.txt'), [...packages.values()].sort().join('\n\n----------------------------------------\n\n'));
// The window type-checks its dynamic import of diffs.js against the package's own types.
await writeFile(path.join(outdir, 'diffs.d.ts'), "// Generated by npm run build:diffs: the types of what diffs.js exports (scripts/diffs-entry.mts).\nexport { File, FileDiff, parsePatchFiles } from '@pierre/diffs';\n");
await writeFile(path.join(outdir, 'README.md'), 'Generated by npm run build:diffs from @pierre/diffs. All code, language grammars, and themes load locally. Do not edit generated files.\n');
console.log('Built local Pierre Diffs renderer.');
