{
  // Shared by every TypeScript project in the repo. tsc only type-checks;
  // scripts/build.mjs compiles src/ into out/ with esbuild.
  "compilerOptions": {
    "target": "es2022",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    // Everything first-party is TypeScript; vendored bundles bring a .d.ts.
    "allowJs": false
  }
}
